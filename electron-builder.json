{
  "appId": "com.gitora.app",
  "productName": "Gitora",
  "artifactName": "Gitora.Setup.${version}.${ext}",
  "directories": {
    "output": "outputs/release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "build/icon.png",
    "build/icon.ico",
    "mcp-server.cjs",
    "mcpConnectionManager.cjs",
    "mcpRepository.cjs"
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "node_modules/electron/dist",
        "to": "electron-runtime",
        "filter": ["**/*"]
      }
    ]
  },
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico"
  }
}
