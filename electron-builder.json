{
  "appId": "com.gitora.app",
  "productName": "Gitora",
  "artifactName": "Gitora Setup 0.2.${ext}",
  "directories": {
    "output": "outputs/release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "mcp-server.cjs",
    "mcpConnectionManager.cjs",
    "mcpRepository.cjs"
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.png"
  },
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
